# Unity project source of truth
# Keep Assets/, Packages/, ProjectSettings/ and every asset's .meta file in Git.
# Library and the other caches below are regenerated after cloning the project.

# Codex/local task scratch data
/.utmp/

# Unity-generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Pp]rofilerCaptures/
/[Rr]ecordings/

# Local and exported builds
/[Bb]uild/
/[Bb]uilds/
/[Ee]xported[Oo]bj/
/[Ss]erver[Dd]ata/

# Unity package/import artifacts
*.unitypackage
*.unitypackage.meta
*.blend1
*.blend1.meta

# Unity-generated database and debug files
*.pidb
*.pidb.meta
*.pdb
*.pdb.meta
*.mdb
*.mdb.meta
*.opendb
*.VC.db
*.booproj
*.svd
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Generated IDE projects and per-user settings
*.csproj
*.csproj.user
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.DotSettings.user
*.sln.iml
/.vs/
/.vscode/
/.idea/
/.consulo/

# Unity-installed Rider editor integration
/[Aa]ssets/Plugins/Editor/JetBrains*

# Android/Gradle caches and packaged builds
/.gradle/
*.apk
*.aab
*.app

# Addressables-generated build data
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/link.xml*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Aa]ddressables_[Tt]emp*/

# Visual Scripting-generated caches
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers/
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Test Runner-generated scenes
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

